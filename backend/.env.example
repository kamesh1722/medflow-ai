PORT=5000
# Local MongoDB for development. Vercel must use a remotely reachable MongoDB URI.
MONGODB_URI=mongodb://127.0.0.1:27017/medflow_ai
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-your-own-4-character-password
FRONTEND_ORIGIN=http://localhost:5173
NODE_ENV=development
