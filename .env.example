# Keep /api in production so requests stay on the frontend's domain.
# Local development uses the Vite proxy in vite.config.js.
VITE_API_BASE_URL=/api
# Optional preview-only mode. Set true to use isolated in-memory demonstration records.
VITE_DEMO_MODE=false
# Auth routes default to /auth/login, /auth/me, and /auth/logout under the API base URL.
